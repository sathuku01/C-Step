# ──────────────────────────────────────────────────────────────────────────────
# C-Step Backend Environment Variables
# Copy this file to .env and fill in real values before running the server.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core ──────────────────────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically if missing).
DB_PATH=c-step.db

# Secret used to sign and verify JWT access tokens. Must be a long, random
# string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production

# ─── Climatiq ──────────────────────────────────────────────────────────────────
# API key from https://www.climatiq.io — required for emissions calculations.
CLIMATIQ_API_KEY=

# ─── Blockchain ────────────────────────────────────────────────────────────────
# When ETHEREUM_RPC_URL is empty (or the variable is omitted) the server
# starts in mock mode: anchoring is simulated in-process with no real chain
# interaction, useful for local development and CI.

# JSON-RPC endpoint of an EVM-compatible node.
# Examples:
#   Polygon Amoy testnet : https://rpc.ankr.com/polygon_amoy/<api-key>
#   Hardhat local node   : http://localhost:8545
#   Infura               : https://polygon-amoy.infura.io/v3/<project-id>
ETHEREUM_RPC_URL=

# EIP-155 chain ID that matches your RPC endpoint.
#   Polygon Amoy testnet : 80002
#   Hardhat              : 31337
#   Ethereum mainnet     : 1
BLOCKCHAIN_CHAIN_ID=80002

# Deployed address of the EcoBidBadge contract (0x-prefixed).
CONTRACT_ADDRESS=

# Hex-encoded ECDSA private key of the wallet that owns the EcoBidBadge
# contract.  This wallet pays gas for every mint() transaction.
# NEVER commit a funded mainnet key.  Use a test wallet for development.
DEPLOYER_PRIVATE_KEY=

# How long (in seconds) the backend waits for a mint() transaction to be
# confirmed before returning an error.  Defaults to 60.
BLOCKCHAIN_CONFIRM_TIMEOUT_S=60
